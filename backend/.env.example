# Copy to .env. Every value here is optional: with an empty file the server
# still runs, using OpenStreetMap for places and a heuristic for ranking.

# --- AI ranking -------------------------------------------------------------
# Without this the server falls back to a scoring heuristic and still returns
# a route. With it, Claude picks the places and writes the reason for each.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Routing ----------------------------------------------------------------
# Free key from openrouteservice.org/dev/#/signup. Gives real pedestrian
# distances; without it the server uses the public OSRM demo (car profile,
# walking times re-derived from distance) and then straight-line estimates.
ORS_API_KEY=
ORS_URL=https://api.openrouteservice.org

OSRM_URL=https://router.project-osrm.org
# The public demo only serves "driving". Self-hosted OSRM can serve "foot".
OSRM_PROFILE=driving
WALKING_SPEED_KMH=4.8

# --- Places and geocoding (no key needed) -----------------------------------
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires a real, identifying User-Agent. Set it.
NOMINATIM_USER_AGENT=citygroup-router/0.1 (you@example.com)

# --- Behaviour --------------------------------------------------------------
SEARCH_RADIUS_M=4000
MAX_CANDIDATES=350
HTTP_TIMEOUT_S=45

# --- Server -----------------------------------------------------------------
# Comma-separated origins, or * while developing.
CORS_ORIGINS=*
# Groups survive a restart in this file. Set to 0 to keep everything in memory.
PERSIST_STATE=1
STATE_FILE=state.json
